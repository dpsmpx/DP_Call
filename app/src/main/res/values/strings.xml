    <string name="welcome">Welcome to DP Call</string>
    <string name="onboarding_intro">Voice calls directly between phones: no sign-up, no phone number, no servers.</string>
    <string name="onboarding_1_title">Exchange codes</string>
    <string name="onboarding_1_text">Send “Your code” from the main screen to the other person and get theirs — through any messenger.</string>
    <string name="onboarding_2_title">Add each other</string>
    <string name="onboarding_2_text">The “Contact” button: paste the code or scan the QR. A call from someone not in your contacts shows as “Unknown caller”.</string>
    <string name="onboarding_3_title">Call</string>
    <string name="onboarding_3_text">Tap the handset next to a contact — the other phone rings even if the app is closed.</string>
    <string name="onboarding_4_title">Stay reachable</string>
    <string name="onboarding_4_text">Allow the microphone and notifications. To avoid missing calls, enable “Don\'t restrict in background” in Settings (the gear). The green “Online” banner means you can be called.</string>
    <string name="onboarding_footer">If the other person is offline, the invitation can be sent manually — the button appears on the call screen.</string>
