+func (h *VKHeadlessJoiner) maybeOffer() {
+	if !h.initiator || h.pc == nil || h.remotePeerID == nil || h.pc.LocalDescription() != nil {
+		return
+	}
+	offer, err := h.pc.CreateOffer(nil)
+	if err != nil {
+		h.Status.EmitStatusError("create offer")
+		return
+	}
+	if err = h.pc.SetLocalDescription(offer); err != nil {
+		h.Status.EmitStatusError("set local offer")
+		return
+	}
+	h.vkSendTransmitData(*h.remotePeerID, map[string]interface{}{"sdp": map[string]interface{}{"type": "offer", "sdp": offer.SDP}})
